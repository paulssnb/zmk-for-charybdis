#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
    // Й / Ж
        td_q_ae: td_q_ae {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <200>;
        bindings = <&kp Q>, <&kp SEMI>;
    };
    // Г / Х
        td_u_h: td_u_h {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <200>;
        bindings = <&kp U>, <&kp LBKT>;
        };
    // Ш / Ъ
        td_i_mz: td_i_mz {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <200>;
        bindings = <&kp I>, <&kp RBKT>;
        };
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

                base_layer { // Layer O
                    display-name = "BASE";
// -----------------------------------------------------------------------------------------
// | Q          | W        | E         | R         | T |   | Y | U         | I         | O        | P             |
// | A (LGUI)   | S (LALT) | D (LCTRL) | F (LSHFT) | G |   | H | J (RSHFT) | K (RCTRL) | L (RALT) | SQT (RGUI)    |
// | Z (BUTTON) | X        | C         | V         | B |   | N | M         | COMMA     | DOT      | FSLH (BUTTON) |
//               | ESC (MEDIA) | SPC (NAV) | TAB (FUN) |   | RET (SYM) | BSPC (NUM) |
                        bindings = <
   &td_q_ae    &kp W       &kp E        &kp R        &kp T   &kp Y &td_u_h       &td_i_mz         &kp O         &kp P
   &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G   &kp H &hmr RSHFT J  &hmr RCTRL K     &hmr RALT L   &hmr RGUI SQT
   &lt 5 Z     &kp X       &kp C        &kp V        &kp B   &kp N &kp M         &kp COMMA        &kp DOT       &lt 5 FSLH
                             &lt 6 ESC &lt 4 SPC &lt 9 TAB   &lt 8 RET &lt 7 BSPC
                        >;
                };
 
                btap_layer { // Layer 1
                    display-name = "BTAP";
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I     |  O    |  P      |
// |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K     |  L    |  SQT    |
// |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  COMMA |  DOT  |  FSLH   |
//             | ESC | SPC | TAB |   | RET | BSPC |
                        bindings = <
   &td_q_ae &kp W &kp E &kp R &kp T   &kp Y &td_u_h &td_i_mz  &kp O   &kp P
   &kp A    &kp S &kp D &kp F &kp G   &kp H &kp J   &kp K     &kp L   &kp SQT
   &kp Z    &kp X &kp C &kp V &kp B   &kp N &kp M   &kp COMMA &kp DOT &kp FSLH
            &kp ESC &kp SPC &kp TAB   &kp RET &kp BSPC
                        >;
                };
 
                cdh_layer { // Layer 2
                    display-name = "CDH";
// -----------------------------------------------------------------------------------------
// | Q          | W        | F         | P         | B |   | J | L         | U         | Y        | SQT           |
// | A (LGUI)   | R (LALT) | S (LCTRL) | T (LSHFT) | G |   | M | N (RSHFT) | E (RCTRL) | I (RALT) | O (RGUI)      |
// | Z (BUTTON) | X        | C         | D         | V |   | K | H         | COMMA     | DOT      | FSLH (BUTTON) |
//               | ESC (MEDIA) | SPC (NAV) | TAB (FUN) |   | RET (SYM) | BSPC (NUM) |
                        bindings = <
   &kp Q       &kp W       &kp F        &kp P        &kp B   &kp J &kp L        &kp U        &kp Y       &kp SQT
   &hml LGUI A &hml LALT R &hml LCTRL S &hml LSHFT T &kp G   &kp M &hmr RSHFT N &hmr RCTRL E &hmr RALT I &hmr RGUI O
   &kp Z       &kp X       &kp C        &kp D        &kp V   &kp K &kp H        &kp COMMA    &kp DOT     &kp FSLH
                             &lt 6 ESC &lt 4 SPC &lt 9 TAB   &lt 8 RET &lt 7 BSPC
                        >;
                };
 
                ctap_layer { // Layer 3
                    display-name = "CTAP";
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L  |  U      |  Y    |  SQT  |
// |  A  |  R  |  S  |  T  |  G  |   |  M  |  N  |  E      |  I    |  O    |
// |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H  |  COMMA  |  DOT  |  FSLH |
//             | ESC | SPC | TAB |   | ENT | BSPC |
                        bindings = <
   &kp Q    &kp W &kp F &kp P &kp B   &kp J &kp L  &kp U     &kp Y   &kp SQT
   &kp A    &kp R &kp S &kp T &kp G   &kp M &kp N  &kp E     &kp I   &kp O
   &kp Z    &kp X &kp C &kp D &kp V   &kp K &kp H  &kp COMMA &kp DOT &kp FSLH
            &kp ESC &kp SPC &kp TAB   &kp RET &kp BSPC
                        >;
                };
 
                navigation_layer { // Layer 4
                    display-name = "NAV";
// -----------------------------------------------------------------------------------------
// |      |      |       |       |    |   | K_REDO | LC(V) | LC(C) | LC(X) | K_UNDO |
// | LGUI | LALT | LCTRL | LSHFT |    |   | LEFT   | DOWN  | UP    | RIGHT | CLCK   |
// |      |      |       |       |    |   | HOME   | PG_DN | PG_UP | END   | INS    |
//                     |    |    |    |   | ENT | BSPC |
                        bindings = <
   &none    &none    &none     &none     &none    &kp K_REDO &kp LC(V) &kp LC(C) &kp LC(X) &kp K_UNDO
   &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none    &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT &kp CLCK
   &none    &none    &none     &none     &none    &kp HOME   &kp PG_DN &kp PG_UP &kp END   &kp INS
                             &none &none &none    &kp RET &kp BSPC
                        >;
                };
 
                button_layer { // Layer 5
                    display-name = "BUTTON";
// -----------------------------------------------------------------------------------------
// | BOOT |       |        |        |    |   |    |        |        |       | BOOT |
// |      |       | K_UNDO | K_REDO |    |   |    | K_REDO | K_UNDO |       |      |
// |      | LC(X) | LC(C)  | LC(V)  |    |   |    | LC(V)  | LC(C)  | LC(X) |      |
//                        |    |    |    |   |    |    |
                        bindings = <
   &bootloader &none     &none      &none      &none   &none &none      &none      &none     &bootloader
   &none       &none     &kp K_UNDO &kp K_REDO &none   &none &kp K_REDO &kp K_UNDO &none     &none
   &none       &kp LC(X) &kp LC(C)  &kp LC(V)  &none   &none &kp LC(V)  &kp LC(C)  &kp LC(X) &none
                                   &none &none &none   &none &none
                        >;
                };
 
                media_layer { // Layer 6
                    display-name = "MEDIA";
// -----------------------------------------------------------------------------------------
// |      |      |       |       |    |   | RGB_TOG | RGB_EFF  | RGB_HUI  | RGB_SAI  | RGB_BRI |
// | LGUI | LALT | LCTRL | LSHFT |    |   | EP_TOG  | K_PREV   | C_VOL_DN | C_VOL_UP | C_NEXT  |
// |      |      |       |       |    |   | OUT_TOG | BT_SEL 0 | BT_SEL 1 | BT_CLR   | RGB_BRD |
//                     |    |    |    |   | C_STOP | C_PP |
                        bindings = <
   &none    &none    &none     &none     &none   &rgb_ug RGB_TOG   &rgb_ug RGB_EFF  &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI
   &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none   &ext_power EP_TOG &kp K_PREV       &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT
   &none    &none    &none     &none     &none   &out OUT_TOG      &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_CLR      &rgb_ug RGB_BRD
                             &none &none &none   &kp C_STOP &kp C_PP
                        >;
                };
 
                num_layer { // Layer 7
                    display-name = "NUM";
// -----------------------------------------------------------------------------------------
// | LBKT  | N7 | N8 | N9 | RBKT  |   |    |       |       |      |      | (BASE) |
// | SEMI  | N4 | N5 | N6 | EQUAL |   |    | RSHFT | RCTRL | RALT | RGUI | (NAV)  |
// | GRAVE | N1 | N2 | N3 | BSLH  |   |    |       |       |      |      |        |
//             | DOT | N0 | MINUS |   |    |    |
                        bindings = <
   &kp LBKT  &kp N7 &kp N8 &kp N9 &kp RBKT   &none &none     &none     &none    &none
   &kp SEMI  &kp N4 &kp N5 &kp N6 &kp EQUAL  &none &kp RSHFT &kp RCTRL &kp RALT &kp RGUI
   &kp GRAVE &kp N1 &kp N2 &kp N3 &kp BSLH   &none &none     &none     &none    &none
                  &kp DOT &kp N0 &kp MINUS   &none &none
                        >;
                };
 
                sym_layer { // Layer 8
                    display-name = "SYM";
// -----------------------------------------------------------------------------------------
// | LBRC  | AMPS | ASTRK | LPAR  | RBRC |   |    |       |       |      |      |
// | COLON | DLLR | PRCNT | CARET | PLUS |   |    | RSHFT | RCTRL | RALT | RGUI |
// | TILDE | EXCL | AT    | HASH  | PIPE |   |    |       |       |      |      |
//                 | LPAR | RPAR | UNDER |   |   |    |
                        bindings = <
   &kp LBRC  &kp AMPS &kp ASTRK &kp LPAR  &kp RBRC   &none &none     &none     &none    &none
   &kp COLON &kp DLLR &kp PRCNT &kp CARET &kp PLUS   &none &kp RSHFT &kp RCTRL &kp RALT &kp RGUI
   &kp TILDE &kp EXCL &kp AT    &kp HASH  &kp PIPE   &none &none     &none     &none    &none
                       &kp LPAR &kp RPAR &kp UNDER   &none &none
                        >;
                };
 
                fun_layer { // Layer 9
                    display-name = "FUN";
// -----------------------------------------------------------------------------------------
// | F13  | F14  | F15   | F16   |    |   | PSCRN       | F7 | F8 | F9 | F12 |
// | LGUI | LALT | LCTRL | LSHFT |    |   | SLCK        | F4 | F5 | F6 | F11 |
// | F17  | F18  | F19   | F20   |    |   | PAUSE_BREAK | F1 | F2 | F3 | F10 |
//                     |    |    |    |   | RET | K_APP |
                        bindings = <
   &kp F13  &kp F14  &kp F15   &kp F16   &none   &kp PSCRN       &kp F7 &kp F8 &kp F9 &kp F12
   &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none   &kp SLCK        &kp F4 &kp F5 &kp F6 &kp F11
   &kp F17  &kp F18  &kp F19   &kp F20   &none   &kp PAUSE_BREAK &kp F1 &kp F2 &kp F3 &kp F10
                             &none &none &none   &kp RET
                        >;
                };
        };
};

//         Mouse {
//             bindings = <
// &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
// &none         &none         &mkp MCLK     &none      &none         &none           &none      &mkp MCLK     &none         &none
// &none         &mkp RCLK     &mo 4         &mkp LCLK  &none         &studio_unlock  &mkp LCLK  &mo 4         &mkp RCLK     &none
//                                    &none  &mkp LCLK  &mkp RCLK     &mkp RCLK  &mkp LCLK
//             >;
//         };
// 
//         Scroll {
//             bindings = <
// &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
// &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none
// &none         &mkp RCLK     &none         &mkp LCLK  &none         &none       &mkp LCLK  &none         &mkp RCLK     &none
//                                    &none  &mkp LCLK  &mkp RCLK     &mkp RCLK  &mkp LCLK
//             >;
//         };
//     };
// };
