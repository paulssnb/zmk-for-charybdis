#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings =
&kp Q          &kp W  &kp E  &kp R  &kp T                    &kp Y  &kp U  &kp I           &kp O           &kp P
&mt LSHFT A    &mt LCTRL S  &kp D  &kp F  &kp G              &kp H  &kp J  &kp K           &mt LCTRL L     &mt LSHFT SEMI
&lt 3 Z        &kp X  &kp C  &kp V  &kp B                    &kp N  &kp M  &kp COMMA       &kp DOT         &lt 3 SLASH
                      &kp LGUI  &kp SPACE  &lt 1 ENTER          &lt 2 ENTER  &kp RIGHT_ALT
            >;
        };

        Lower {
            bindings =
&kp N1     &kp N2  &kp N3     &kp N4     &kp LBKT   &kp RBKT       &kp F1  &kp F2  &kp F3  &kp F4
&kp N5     &kp N6  &kp N7     &kp N8     &none      &kp BACKSLASH  &kp F5  &kp F6  &kp F7  &kp F8
&kp N9     &kp N0  &kp MINUS  &kp EQUAL  &none      &none          &kp F9  &kp F10 &kp F11 &kp F12
                   &kp LEFT_WIN  &kp SPACE  &trans      &kp ENTER  &kp RIGHT_ALT
            >;
        };

        Raise {
            bindings =
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)     &kp LS(LBKT)  &kp LS(RBKT)       &kp TAB      &kp ESCAPE  &kp APOS  &kp BACKSPACE
&kp LS(N5)  &kp LS(N6)  &kp LS(N7)     &kp LS(N8)     &kp DELETE    &kp LS(BACKSLASH)  &kp CAPSLOCK &kp UP      &kp LEFT_ALT  &none
&kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)  &kp LS(EQUAL)  &bootloader   &none              &kp LEFT     &kp DOWN    &kp RIGHT &none
                        &kp LEFT_WIN   &kp SPACE      &kp ENTER          &trans         &kp RIGHT_ALT
            >;
        };

        Mouse {
            bindings =
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none         &bt BT_CLR    &bt BT_CLR    &none         &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
&none         &none         &mkp MCLK     &none         &none         &none         &none         &mkp MCLK     &none         &none
&none         &mkp RCLK     &mo 4         &mkp LCLK     &none         &studio_unlock &mkp LCLK    &mo 4         &mkp RCLK     &none
                            &none         &mkp LCLK     &mkp RCLK          &mkp RCLK     &mkp LCLK
            >;
        };

        Scroll {
            bindings =
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none         &bt BT_CLR    &bt BT_CLR    &none         &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
&none         &none         &mkp MCLK     &none         &none         &none         &none         &mkp MCLK     &none         &none
&none         &mkp RCLK     &none         &mkp LCLK     &none         &none         &mkp LCLK     &none         &mkp RCLK     &none
                            &none         &mkp LCLK     &mkp RCLK          &mkp RCLK     &mkp LCLK
            >;
        };
    };
};
